# =============================================================================
# Cloud / CLI / credenciais
# =============================================================================
# AWS
.aws/
*.pem
credentials
config
# gcloud (arquivos de conta costumam ser .json)
.gcloud/
*credentials*.json
*secrets*.json
*-key.json
# Azure
.azure/
# Terraform (estado pode conter segredos)
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
# Kubectl
kubeconfig
*.kubeconfig

